# ElevenLabs API key — required for voiceover and sound-effect generation.
# Get one at https://elevenlabs.io/app/settings/api-keys
# Needs: Text to Speech, Sound Effects, Voices.
# (Background music comes from Suno, not ElevenLabs — see docs/suno-prompt.md.)
ELEVENLABS_API_KEY=sk_your_key_here

# Optional: pin a specific narration voice. If unset, scripts/generate-audio.mjs
# lists available voices and picks a narration-labelled one.
ELEVENLABS_VOICE_ID=
